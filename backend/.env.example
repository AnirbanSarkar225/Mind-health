# =================================================================
# Gita-NeuroSync Backend Configuration
# =================================================================
# NOTE: All configuration below is OPTIONAL for local development.
# If DATABASE_URL is not set, Gita-NeuroSync automatically boots in
# Local In-Memory Mode: registration, login, email OTP verification,
# sessions, and feedback all function locally with zero external setup.
# =================================================================

# Server Port (default 5000)
PORT=5000

# JWT Secret for signing auth tokens
JWT_SECRET=neurosync_super_secret_jwt_key_2026_change_in_production

# Optional: External Supabase PostgreSQL Database URL
# Uncomment and fill in if you want persistent cloud database storage:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Optional: Real OTP Email Dispatch (Gmail SMTP or Resend API)
# In development, OTP is always logged to the backend terminal console,
# and universal test bypass codes (000000, 123456, 999999) are always accepted.
# SMTP_EMAIL=your-email@gmail.com
# SMTP_APP_PASS=your-gmail-app-password
# RESEND_API_KEY=re_your_resend_api_key
